# ========================================================
# AI-Based Smart Yard Gate Automation System Environment Config
# ========================================================

# Flask Application Settings
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-me-to-a-secure-random-key-in-production

# Server Configuration
HOST=0.0.0.0
PORT=5000

# Database Configuration (MySQL as primary, SQLite option for lightweight local testing)
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smart_yard_db

# Toggle to True to run with local SQLite database instead of MySQL
USE_SQLITE=False
SQLITE_DB_PATH=smart_yard.db

# File Upload Settings
UPLOAD_FOLDER=static/uploads
MAX_CONTENT_LENGTH=16777216  # 16 MB max upload size
ALLOWED_EXTENSIONS=png,jpg,jpeg,mp4,avi,mov

# Model & Detection Settings
YOLO_MODEL_PATH=models/yolo/yolov8n.pt
DETECTION_CONF_THRESHOLD=0.50
OCR_CONF_THRESHOLD=0.60
